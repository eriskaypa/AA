<Window x:Class="AA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="AA" Height="820" Width="1280" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/AA.ico">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New"/>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/>
        <KeyBinding Key="R" Modifiers="Control" Command="NavigationCommands.Refresh"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed"/>
        <CommandBinding Command="NavigationCommands.Refresh" Executed="RefreshDueCommand_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource Panel}" Foreground="{DynamicResource Fg}">
            <MenuItem Header="_File" Foreground="{DynamicResource Fg}">
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem Header="Save _As..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Reload from disk" Click="MenuLoad_Click"/>
                <MenuItem Header="_Import from file..." Click="MenuImport_Click"/>
                <Separator/>
                <MenuItem Header="_Trash (restore deleted items)..." Click="MenuTrash_Click"
                          ToolTip="Restore items you deleted, or remove them for good. Deletes go here instead of vanishing — Ctrl+Z undoes the last one."/>
                <MenuItem x:Name="EncryptLocalMenu" Header="Encr_ypt local data file (this PC)" IsCheckable="True" Click="MenuEncryptLocal_Click"
                          ToolTip="Encrypt this PC's data file at rest with Windows DPAPI (tied to your Windows account). Shared, exported and Google Drive copies stay portable plaintext, so sync between machines is unaffected."/>
                <Separator/>
                <MenuItem Header="Set s_hared save file..." Click="MenuSetSharedFile_Click"
                          ToolTip="Use ONE save file at a location you choose (e.g. a network drive or a synced folder). AA autosaves there every 10 minutes and auto-reloads when another copy of AA updates it — point every PC at the same file to keep them in sync."/>
                <MenuItem Header="Stop shared save file" Click="MenuStopSharedFile_Click"
                          ToolTip="Go back to saving locally on this PC only."/>
                <Separator/>
                <MenuItem Header="Open data _folder" Click="MenuOpenFolder_Click"/>
                <MenuItem Header="_Export data folder (ZIP)..." Click="MenuExportFolder_Click"/>
                <MenuItem Header="I_mport data folder (ZIP)..." Click="MenuImportFolder_Click"/>
                <Separator/>
                <MenuItem Header="Save a copy to Google _Drive (synced folder)" Click="MenuSaveToDrive_Click"
                          ToolTip="Save a timestamped backup ZIP into your Google Drive desktop folder, which syncs it to the cloud."/>
                <MenuItem Header="Set Google Drive folde_r..." Click="MenuSetDriveFolder_Click"
                          ToolTip="Choose which local folder is your Google Drive (the one Google Drive for desktop syncs)."/>
                <Separator/>
                <MenuItem Header="Upload backup to Google Drive (O_Auth)..." Click="MenuUploadDriveOAuth_Click"
                          ToolTip="Upload a backup directly to Google Drive via the Drive API (no desktop client needed). Requires a Google OAuth client."/>
                <MenuItem Header="_Load backup from Google Drive (OAuth)..." Click="MenuLoadDriveOAuth_Click"
                          ToolTip="Download a backup from your Google Drive and (after a newer/older check) replace your current data with it."/>
                <MenuItem Header="Set Google OAuth _client (client_secret.json)..." Click="MenuSetOAuthClient_Click"
                          ToolTip="Load the client_secret.json you downloaded from Google Cloud Console (OAuth 'Desktop app' client)."/>
                <MenuItem Header="Sign out of _Google" Click="MenuGoogleSignOut_Click"
                          ToolTip="Forget the cached Google sign-in for OAuth uploads."/>
                <Separator/>
                <MenuItem x:Name="SyncOnSaveMenu" Header="_Sync to Google Drive on save" IsCheckable="True" Click="MenuSyncOnSave_Click"
                          ToolTip="When on, Ctrl+S also pushes your data to Google Drive (OAuth), and the app checks for a newer save pushed from other PCs."/>
                <MenuItem Header="C_heck Google Drive for newer save" Click="MenuCheckRemote_Click"
                          ToolTip="Ask Google Drive whether a newer save state exists, and offer to load it."/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="{DynamicResource Fg}">
                <MenuItem Header="_Folder builder..." Click="MenuFolderBuilder_Click"
                          ToolTip="Bulk-create a folder structure (with subfolders) at a location of your choice."/>
                <MenuItem Header="Date _calculator..." Click="MenuDateCalc_Click"
                          ToolTip="Find the range between two dates, or add/subtract days from a date."/>
                <MenuItem Header="Floating _due-dates window" Click="OpenFloating_Click"
                          ToolTip="Show a small always-on-top window of items due today and tomorrow."/>
                <MenuItem Header="Quick _work window (Ctrl+N)" Click="MenuQuickWork_Click"
                          ToolTip="Big window: all tasks &amp; procedures on the left (active first), a comprehensive builder on the right."/>
                <MenuItem Header="Quick s_witcher (Ctrl+O)" Click="MenuQuickSwitcher_Click"
                          ToolTip="Fuzzy-jump to any item by name, kind or #tag — Obsidian-style. Type, then Enter."/>
                <MenuItem Header="_Activity log..." Click="MenuActivityLog_Click"
                          ToolTip="UTC-timestamped log of every entry added and removed."/>
                <MenuItem Header="U_nit converter..." Click="MenuUnitConverter_Click"
                          ToolTip="Convert maritime units — speed, distance, pressure, temperature, volume, mass and more."/>
                <Separator/>
                <MenuItem Header="Import COMPAS _crew (.xlsx)..." Click="MenuImportCompas_Click"
                          ToolTip="Import a COMPAS crew report and keep each member as an info card; tracks contract sign-off expiries."/>
                <MenuItem Header="Check crew contract e_xpiries" Click="MenuCheckExpiries_Click"
                          ToolTip="List crew whose contracts (sign-off dates) are due soon or overdue."/>
                <Separator/>
                <MenuItem Header="SIRE 2.0 e_xport..." Click="MenuSireExport_Click"
                          ToolTip="Export SIRE inspection data (checklist, tasks, status report, and more) to a text file or the clipboard."/>
                <MenuItem Header="Set _Gemini API key..." Click="MenuSetGemini_Click"
                          ToolTip="Set your Google Gemini API key to enable AI task suggestions on the SIRE tab. Stored locally, never committed."/>
                <Separator/>
                <MenuItem Header="Set / change _password..." Click="MenuSetPassword_Click"/>
                <MenuItem Header="_Lock now" Click="MenuLockNow_Click" ToolTip="Forget the unlocked password for this session. Any open locked container will require re-unlock."/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource Fg}">
                <MenuItem x:Name="DarkModeMenu" Header="🌙 _Dark mode" IsCheckable="True" Click="MenuDarkMode_Click"
                          ToolTip="Switch between the light and dark theme (remembered across launches)."/>
                <MenuItem x:Name="ShortcutBarMenu" Header="⌨ _Shortcut bar" IsCheckable="True" Click="MenuShortcutBar_Click"
                          ToolTip="Show/hide the keyboard-shortcuts reminder strip at the bottom of the window."/>
                <MenuItem Header="🎨 _Customize tab colors..." Click="MenuTabColors_Click"
                          ToolTip="Give each main tab its own background colour (remembered across launches)."/>
            </MenuItem>
            <MenuItem Header="_About" Click="MenuAbout_Click" Foreground="{DynamicResource Fg}"/>
        </Menu>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock Text="AA" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="• Equipment/Area / Tasks / Procedures with containers, files &amp; relationships" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock x:Name="SharedStatusBlock" Text="" Visibility="Collapsed" VerticalAlignment="Center"
                               Margin="0,0,12,0" FontWeight="SemiBold"
                               ToolTip="Shared save status. Turns red and stays visible if the shared file goes offline (e.g. a VSAT drop) so you know your edits aren't reaching it yet."/>
                    <TextBlock x:Name="StatusBlock" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="📌 Due" Click="OpenFloating_Click" Margin="0,0,6,0"
                            ToolTip="Show a small floating window of tasks and procedures due today and tomorrow. (Ship work-order notifications live in each vessel's Work Orders tab.)"/>
                    <Button Content="Search (Ctrl+F)" Click="OpenSearch_Click" Margin="0,0,6,0"/>
                    <Button Content="Go to (Ctrl+O)" Click="MenuQuickSwitcher_Click" Margin="0,0,6,0"
                            ToolTip="Quick switcher — fuzzy-jump to any item by name, kind or #tag."/>
                    <Button Content="Load" Click="MenuLoad_Click" Margin="0,0,6,0"/>
                    <Button Content="Save (Ctrl+S)" Style="{StaticResource AccentButton}" Click="MenuSave_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Keyboard-shortcuts reminder strip (hideable; state remembered across launches). -->
        <Border x:Name="ShortcutBar" DockPanel.Dock="Bottom" Background="{DynamicResource PanelAlt}"
                BorderBrush="{DynamicResource BorderB}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="HideShortcutBar_Click" Width="22" Height="20"
                        Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}"
                        Cursor="Hand" ToolTip="Hide this shortcuts strip (View ▸ Shortcut bar to bring it back)."/>
                <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run Text="⌨" FontWeight="Bold"/>
                    <Run Text="  Ctrl+S" FontWeight="Bold"/><Run Text=" Save"/>
                    <Run Text="   ·   Ctrl+F" FontWeight="Bold"/><Run Text=" Search"/>
                    <Run Text="   ·   Ctrl+N" FontWeight="Bold"/><Run Text=" Quick work"/>
                    <Run Text="   ·   Ctrl+O" FontWeight="Bold"/><Run Text=" Go to (quick switcher)"/>
                    <Run Text="   ·   Ctrl+R" FontWeight="Bold"/><Run Text=" Due-dates window"/>
                    <Run Text="   ·   Ctrl+1…9" FontWeight="Bold"/><Run Text=" Switch tab"/>
                    <Run Text="   ·   F2" FontWeight="Bold"/><Run Text=" Rename"/>
                    <Run Text="   ·   Ctrl+Z" FontWeight="Bold"/><Run Text=" Undo delete"/>
                </TextBlock>
            </DockPanel>
        </Border>
        <TabControl Margin="8" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged"
                    AllowDrop="True" ToolTip="Tip: drag a tab to reorder it."
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    Drop="Tab_Drop">
            <TabItem x:Name="TabEquipment" Header="Equipment/Area">
                <views:HierarchyPage x:Name="EquipmentPage"/>
            </TabItem>
            <TabItem x:Name="TabTasks" Header="Tasks">
                <views:HierarchyPage x:Name="TasksPage"/>
            </TabItem>
            <TabItem x:Name="TabProcedures" Header="Procedures">
                <views:HierarchyPage x:Name="ProceduresPage"/>
            </TabItem>
            <TabItem x:Name="TabVessels" Header="Vessels">
                <views:HierarchyPage x:Name="VesselsPage"/>
            </TabItem>
            <TabItem x:Name="TabCalendar" Header="Calendar">
                <views:CalendarPage x:Name="CalendarPg"/>
            </TabItem>
            <TabItem x:Name="TabBoard" Header="Board">
                <views:BoardPage x:Name="BoardPg"/>
            </TabItem>
            <TabItem x:Name="TabPlanner" Header="Planner">
                <views:PlannerPage x:Name="PlannerPg"/>
            </TabItem>
            <TabItem x:Name="TabMap" Header="Relationship Map">
                <views:RelationshipMapPage x:Name="MapPage"/>
            </TabItem>
            <TabItem x:Name="CrewTab" Header="Crew">
                <views:CrewPage x:Name="CrewPg"/>
            </TabItem>
            <TabItem x:Name="TabLists" Header="Saved Lists">
                <views:SavedListsPage x:Name="ListsPg"/>
            </TabItem>
            <TabItem x:Name="TabBuckets" Header="Buckets">
                <views:BucketsPage x:Name="BucketsPg"/>
            </TabItem>
            <TabItem x:Name="TabPorts" Header="Ports">
                <views:PortsPage x:Name="PortsPg"/>
            </TabItem>
            <TabItem x:Name="TabSire" Header="SIRE 2.0">
                <views:SirePage x:Name="SirePg"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
