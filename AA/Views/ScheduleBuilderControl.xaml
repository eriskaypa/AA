<UserControl x:Class="AA.Views.ScheduleBuilderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Template / vessel bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderB}"
                BorderThickness="0,0,0,1" Padding="6,5" Margin="0,0,0,6">
            <WrapPanel>
                <TextBlock Text="Linked vessel:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="VesselBox" Width="180" Margin="0,0,12,0" SelectionChanged="Vessel_Changed"
                          ToolTip="Link this schedule to a vessel (optional)."/>
                <Button Content="💾 Save as..." Click="Save_Click" Margin="0,0,4,0"
                        ToolTip="Save this schedule as a reusable one that can be applied to any crew."/>
                <Button Content="📋 Apply saved..." Click="Apply_Click" Margin="0,0,4,0"
                        ToolTip="Apply a saved schedule to this crew member (append or replace)."/>
                <Button Content="📤 Export..." Click="Export_Click" Margin="0,0,4,0"
                        ToolTip="Export this schedule to a file you can share/import elsewhere."/>
                <Button Content="📥 Import..." Click="Import_Click"
                        ToolTip="Import a schedule file and apply it to this crew member."/>
            </WrapPanel>
        </Border>

        <!-- Interactive add row -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
            <WrapPanel>
                <TextBlock Text="Add:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,4"/>
                <DatePicker x:Name="DateBox" Width="130" Margin="0,0,4,4"/>
                <TextBox x:Name="TimeBox" Width="60" Margin="0,0,4,4" Tag="HH:mm" ToolTip="Time (HH:mm), optional."/>
                <ComboBox x:Name="KindBox" Width="110" Margin="0,0,4,4" SelectionChanged="Kind_Changed"/>
                <TextBox x:Name="TitleBox" Width="200" Margin="0,0,4,4" Tag="What... (or pick an item)"/>
                <Button x:Name="PickBtn" Content="Pick item..." Click="Pick_Click" Margin="0,0,4,4"
                        ToolTip="Pick an existing Task / Procedure / Equipment to schedule."/>
                <Button Content="+ Add" Style="{StaticResource AccentButton}" Click="Add_Click" Margin="0,0,4,4"/>
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="CountText" Foreground="{DynamicResource Muted}" Margin="2,4,0,0"/>

        <!-- Timeline -->
        <ListBox x:Name="Timeline" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Entry.Done, Mode=TwoWay}" Click="Done_Click"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="✕" Click="Delete_Click" Tag="{Binding Entry.Id}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Delete this entry"/>
                        <Button DockPanel.Dock="Right" Content="✎" Click="Edit_Click" Tag="{Binding Entry.Id}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Edit title/notes"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Entry.Time}" Width="46" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" FontFamily="Consolas"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Entry.KindIcon}" Width="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Entry.Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   TextDecorations="{Binding Entry.Done, Converter={StaticResource BoolToStrike}}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelAlt}" Padding="6,3" Margin="0,4,0,2">
                                <DockPanel>
                                    <TextBlock Text="🗓 " Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{DynamicResource Muted}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</UserControl>
