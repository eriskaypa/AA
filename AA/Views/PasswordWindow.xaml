<Window x:Class="AA.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Height="220" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Text="Password" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock x:Name="LblPrompt" Grid.Row="1" Text="Enter password:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="Pb1" Grid.Row="2" Margin="0,0,0,6"/>
        <PasswordBox x:Name="Pb2" Grid.Row="3" Margin="0,0,0,6" Visibility="Collapsed"/>
        <TextBlock x:Name="LblError" Grid.Row="4" Text="" Foreground="#FFD45050" Margin="0,2,0,0" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
