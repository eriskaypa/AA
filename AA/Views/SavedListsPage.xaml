<UserControl x:Class="AA.Views.SavedListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: grouped saved lists -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8,6"
                        BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Saved Lists" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}"/>
                </Border>
                <Border DockPanel.Dock="Top" Padding="6,5" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <Button Content="+ Group" Margin="0,0,4,4" Click="NewGroup_Click"
                                ToolTip="Create a new List Group to bundle saved lists together."/>
                        <Button Content="+ List" Margin="0,0,4,4" Click="NewList_Click"
                                ToolTip="Create a new empty saved list."/>
                        <Button Content="Rename" Margin="0,0,4,4" Click="Rename_Click"/>
                        <Button Content="Delete" Margin="0,0,4,4" Click="Delete_Click"/>
                        <Button Content="Move to group..." Margin="0,0,4,4" Click="AssignGroup_Click"
                                ToolTip="Put the selected saved list into a group (or remove it from all groups)."/>
                        <Button Content="Manage groups..." Margin="0,0,4,4" Click="ManageGroups_Click"
                                ToolTip="Rename or delete List Groups (lists inside a deleted group become ungrouped)."/>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <ListBox x:Name="ListsBox" BorderThickness="0" SelectionChanged="ListsBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat='{}{0} items'}"
                                           Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelAlt}" Padding="6,3" Margin="0,4,0,2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{DynamicResource Muted}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit items..." Click="EditItems_Click"/>
                            <MenuItem Header="Rename" Click="Rename_Click"/>
                            <MenuItem Header="Duplicate" Click="Duplicate_Click"/>
                            <MenuItem Header="Move to group..." Click="AssignGroup_Click"/>
                            <Separator/>
                            <MenuItem Header="Export this list (PDF)..." Click="ExportList_Click"/>
                            <MenuItem Header="Delete" Click="Delete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>

        <!-- Right: selected list detail -->
        <Grid Grid.Column="2" x:Name="DetailRoot" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="DetailName" Text="Select a saved list" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailSub" Foreground="{DynamicResource Muted}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="✎ Edit items..." Style="{StaticResource AccentButton}" Margin="0,0,6,4" Click="EditItems_Click"/>
                        <Button Content="Duplicate" Margin="0,0,6,4" Click="Duplicate_Click"/>
                        <Button Content="📄 Export this list (PDF)..." Margin="0,0,6,4" Click="ExportList_Click"/>
                        <Button Content="📄 Export group (PDF)..." Margin="0,0,6,4" Click="ExportGroup_Click"/>
                        <Button Content="📄 Export ALL (PDF)..." Margin="0,0,6,4" Click="ExportAll_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ItemsPreview" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Foreground="{DynamicResource Muted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
