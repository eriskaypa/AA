<Window x:Class="AA.Views.QuickSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to item" Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="10">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="16" Padding="6,4"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                 Tag="Type a name, kind or #tag..."/>
        <TextBlock DockPanel.Dock="Bottom" Margin="2,6,0,0" Opacity="0.6" FontSize="11"
                   Text="Enter to open  ·  ↑ / ↓ to move  ·  Esc to close"/>
        <ListBox x:Name="ResultList" Margin="0,8,0,0"
                 MouseDoubleClick="ResultList_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <Border DockPanel.Dock="Left" Background="{DynamicResource PanelAlt}" CornerRadius="3"
                                Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="{Binding Tags}" DockPanel.Dock="Right" Opacity="0.6" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
