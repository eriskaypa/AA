<Window x:Class="AA.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Edit saved list" Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Edit the items in this saved list (title, duration, notes &amp; files). Deadlines, working-ranges and done aren't stored in a saved list — they're set when you apply it. Close to save."/>
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </Border>
        <views:ChecklistBuilderControl x:Name="Builder"/>
    </DockPanel>
</Window>
