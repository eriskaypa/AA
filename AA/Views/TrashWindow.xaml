<Window x:Class="AA.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trash" Height="480" Width="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Fg}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"
                   Text="Deleted items are kept here so a mistake can be undone. Restore puts an item (with its whole subtree) back where it was. Items are auto-removed after 90 days, or once there are more than 200."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RestoreBtn" Content="↩ Restore" Style="{StaticResource AccentButton}" Click="Restore_Click" Margin="0,0,6,0"
                    ToolTip="Put the selected item(s) back where they were."/>
            <Button x:Name="DeleteBtn" Content="Delete permanently" Click="DeletePermanent_Click" Margin="0,0,6,0"
                    ToolTip="Remove the selected item(s) from the Trash for good (cannot be undone)."/>
            <Button Content="Empty Trash" Click="Empty_Click" Margin="0,0,18,0"
                    ToolTip="Permanently remove everything in the Trash."/>
            <Button Content="Close" Click="Close_Click" MinWidth="80"/>
        </StackPanel>
        <ListView x:Name="List" SelectionMode="Extended"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Kind" Width="160" DisplayMemberBinding="{Binding KindLabel}"/>
                    <GridViewColumn Header="Deleted" Width="150" DisplayMemberBinding="{Binding DeletedLocal}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
