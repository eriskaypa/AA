<Window x:Class="AA.Views.SubtaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Edit subtask" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Name:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" TextChanged="Name_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Description:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="DescBox" TextChanged="Desc_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Deadline:" Width="100" VerticalAlignment="Center"/>
                <DatePicker x:Name="DeadlinePicker" Width="200" HorizontalAlignment="Left" SelectedDateChanged="Deadline_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Recurrence:" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="RecurrenceBox" Width="200" HorizontalAlignment="Left" SelectionChanged="Recurrence_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Status:" Width="100" VerticalAlignment="Center"/>
                <ComboBox x:Name="StatusBox" Width="200" HorizontalAlignment="Left" SelectionChanged="Status_Changed"
                          ToolTip="Workflow status used by the Board (Done keeps the Completed box in sync)."/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Completed:" Width="100" VerticalAlignment="Center"/>
                <CheckBox x:Name="DoneBox" Content="Mark as done" Checked="Done_Changed" Unchecked="Done_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Job:" Width="100" VerticalAlignment="Center"/>
                <CheckBox x:Name="JobBox" Content="Schedulable job" VerticalAlignment="Center"
                          Checked="Job_Changed" Unchecked="Job_Changed"
                          ToolTip="Tag this task as a Job so it can be dragged onto the Planner."/>
                <TextBlock Text="Duration (min):" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="DurationBox" Width="80" HorizontalAlignment="Left" TextChanged="Duration_Changed"/>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <views:ContainerEditor x:Name="ContainerCtrl"/>
    </DockPanel>
</Window>
