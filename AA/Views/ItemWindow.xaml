<Window x:Class="AA.Views.ItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Item" Height="720" Width="900" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico" Closing="Window_Closing">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="KindText" DockPanel.Dock="Left" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="StateText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"
                       Margin="0,0,8,4" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                     TextChanged="NameBox_TextChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Top"
                       Margin="0,4,8,4" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="DescBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                     AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="4"
                     VerticalScrollBarVisibility="Auto" TextChanged="DescBox_TextChanged"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tags" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="{DynamicResource Muted}"/>
            <TextBox x:Name="TagsBox" Grid.Row="2" Grid.Column="1" TextChanged="TagsBox_TextChanged"
                     ToolTip="Comma-separated."/>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap"
                   Text="Schedule, subtasks, steps and relationships stay in the main window — this window covers the notes and file bank."/>

        <views:ContainerEditor x:Name="ContainerCtrl"/>
    </DockPanel>
</Window>
