<Window x:Class="AA.Views.FloatingTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overdue, today &amp; tomorrow"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="CanResize"
        Width="350" Height="480" MinWidth="260" MinHeight="220" SizeToContent="Manual">
    <Border CornerRadius="12" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#FF000000"/>
        </Border.Effect>
        <Grid>
        <DockPanel>
            <!-- Header (draggable) -->
            <Border DockPanel.Dock="Top" CornerRadius="12,12,0,0" Padding="14,12" MouseLeftButtonDown="Header_Drag">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF3A7BD5" Offset="0"/>
                        <GradientStop Color="#FF00A88E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="⟳" Click="Refresh_Click" Foreground="White" Background="Transparent" BorderThickness="0"
                                FontSize="15" Width="26" Height="26" Cursor="Hand" ToolTip="Refresh"/>
                        <Button Content="✕" Click="Close_Click" Foreground="White" Background="Transparent" BorderThickness="0"
                                FontSize="14" Width="26" Height="26" Cursor="Hand" ToolTip="Close"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="📌  Due dates" Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderSub" Text="Today &amp; tomorrow" Foreground="#FFEAF6FF" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Host" Margin="12"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Explicit resize grip (borderless+transparent windows have thin, hard-to-grab edges). -->
        <Thumb x:Name="ResizeGrip" Width="18" Height="18" Margin="0,0,2,2"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta" ToolTip="Drag to resize">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.5" SnapsToDevicePixels="True"
                              Data="M 16,4 L 4,16  M 16,9 L 9,16  M 16,14 L 14,16"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        </Grid>
    </Border>
</Window>
