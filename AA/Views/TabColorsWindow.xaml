<Window x:Class="AA.Views.TabColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize tab colors" Height="560" Width="480" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Pick a background colour for each main tab. The active tab keeps its colour with an accent underline. 'Default' restores the theme colour."
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormHost" Margin="0,0,10,0"/>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Reset all" HorizontalAlignment="Left" Click="ResetAll_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Apply" Width="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Apply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
