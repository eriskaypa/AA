<UserControl x:Class="AA.Views.BoardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Card shown in every column. Bound to a lightweight Card projection. -->
        <DataTemplate x:Key="CardTemplate">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,8" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="6,0,0,6"/>
                    <StackPanel Grid.Column="1" Margin="10,8">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"
                                   TextDecorations="{Binding Done, Converter={StaticResource BoolToStrike}}"/>
                        <TextBlock Text="{Binding Meta}" Foreground="{Binding MetaBrush}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding MetaVisible}"/>
                        <TextBlock Text="{Binding Badges}" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding BadgesVisible}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Stretch cards to the column width and strip the default selection chrome. -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock Text="Task Board" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Drag cards between columns to set status" Foreground="{DynamicResource Muted}"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SearchBox" Width="180" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                    <CheckBox x:Name="HideDoneChk" Content="Hide done" VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="HideDone_Changed" Unchecked="HideDone_Changed"/>
                    <Button Content="+ New task" Style="{StaticResource AccentButton}" Click="NewTask_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ColumnsRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </DockPanel>
</UserControl>
