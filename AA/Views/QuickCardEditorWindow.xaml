<Window x:Class="AA.Views.QuickCardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick card" Height="600" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="OK" MinWidth="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Title" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="TitleBox" TextChanged="Title_Changed" Margin="0,0,0,10"/>

                <TextBlock Text="Target" FontWeight="Bold" Margin="0,0,0,3"/>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="TypeLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox x:Name="TargetBox" IsReadOnly="True"/>
                </DockPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="🔗 Link file (in place)" Click="LinkFile_Click" Margin="0,0,6,4"
                            ToolTip="Reference a file at its original location (e.g. on a network drive) — no copy."/>
                    <Button Content="📄 Import a copy" Click="ImportCopy_Click" Margin="0,0,6,4"
                            ToolTip="Copy the file into the app data folder."/>
                    <Button Content="📁 Link folder" Click="LinkFolder_Click" Margin="0,0,6,4"
                            ToolTip="Reference a folder (opens in Explorer)."/>
                    <Button Content="🌐 Web link..." Click="WebLink_Click" Margin="0,0,6,4"/>
                </WrapPanel>

                <TextBlock Text="Icon" FontWeight="Bold" Margin="0,0,0,3"/>
                <Border BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4" Height="116" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="IconPanel" Margin="4"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="Colour" FontWeight="Bold" Margin="0,0,0,3"/>
                <WrapPanel x:Name="ColorPanel" Margin="0,0,0,6"/>
                <Button Content="Custom colour..." HorizontalAlignment="Left" Click="CustomColor_Click" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="WidthBox" Width="64" TextChanged="Size_Changed" Margin="0,0,12,0"/>
                    <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="HeightBox" Width="64" TextChanged="Size_Changed"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border x:Name="PreviewCard" Width="190" Height="130" CornerRadius="10" HorizontalAlignment="Left">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PrevIcon" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PrevTitle" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="6,6,6,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Tip: on the vessel screen, drag a card to move it and drag its bottom-right corner to resize."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
