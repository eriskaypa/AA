<Window x:Class="AA.Views.ListStylePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List style" SizeToContent="Height" Width="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/AA.ico">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="How should the items be listed?"/>

        <RadioButton x:Name="BulletsRadio" GroupName="Style" IsChecked="True" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="• Bulleted" FontWeight="Bold"/>
                <TextBlock Text="Every item marked with a bullet. Best when the order does not matter."
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="NumbersRadio" GroupName="Style" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="1. Numbered" FontWeight="Bold"/>
                <TextBlock Text="Items numbered in order. Best for steps that run in sequence."
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,5" Margin="0,0,8,0"/>
            <Button Content="Continue" IsDefault="True" Padding="16,5" FontWeight="Bold" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
