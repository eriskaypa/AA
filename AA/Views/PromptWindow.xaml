<Window x:Class="AA.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="170" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Text="Title" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock x:Name="LblPrompt" Grid.Row="1" Text="Prompt:" Margin="0,0,0,4"/>
        <TextBox x:Name="Tb" Grid.Row="2" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
