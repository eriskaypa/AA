<Window x:Class="AA.Views.FlashSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flash Sync with iPhone" Height="760" Width="920" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico" Closing="Window_Closing">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Flash Sync with iPhone" FontWeight="Bold" FontSize="16"
                   Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Moves your text, changes and formatting between this PC and the iPhone app by flashing QR codes on screen — no network, no cable, no Wi-Fi. Attachments are not carried; files already on the other device are left exactly as they are."/>

        <TabControl>
            <!-- ============ SEND ============ -->
            <TabItem Header="Send to iPhone">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SendSummary" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SendHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="On the iPhone: More ▸ Backup &amp; Transfer ▸ Flash Sync with PC ▸ Receive, then point it at this window."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="SendStartBtn" Content="Start flashing" Click="SendStart_Click" Padding="14,5" FontWeight="Bold"/>
                            <Button x:Name="SendStopBtn" Content="Stop" Click="SendStop_Click" Margin="8,0,0,0" Padding="14,5" IsEnabled="False"/>
                            <TextBlock Text="Speed" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="{DynamicResource Muted}"/>
                            <Slider x:Name="FpsSlider" Minimum="6" Maximum="15" Value="12" Width="120" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Fps_Changed"/>
                            <TextBlock x:Name="FpsText" Text="12 / sec" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock x:Name="SendProgress" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                        <Button x:Name="ConfirmedBtn" Content="The iPhone says it got it" Click="Confirmed_Click"
                                Padding="14,6" HorizontalAlignment="Left" IsEnabled="False"
                                ToolTip="Press this only once the iPhone reports the transfer completed. It records what the phone now has, so next time only your newer changes need to be sent."/>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Only press that when the phone has actually confirmed. It is what makes the next sync short — and if it is pressed early, the changes it skips would never be sent again."/>
                    </StackPanel>

                    <!-- White plate + quiet zone, regardless of app theme: brightness and margin are what a
                         camera locks onto. NearestNeighbor keeps the modules square at any window size. -->
                    <Border Background="White" CornerRadius="4" Padding="18" MinHeight="300">
                        <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ============ RECEIVE ============ -->
            <TabItem Header="Receive from iPhone">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Camera" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Muted}"/>
                            <ComboBox x:Name="CameraCombo" Width="190" VerticalAlignment="Center"/>
                            <Button x:Name="RecvStartBtn" Content="Start camera" Click="RecvStart_Click" Margin="8,0,0,0" Padding="14,5" FontWeight="Bold"/>
                            <Button x:Name="RecvStopBtn" Content="Stop" Click="RecvStop_Click" Margin="8,0,0,0" Padding="14,5" IsEnabled="False"/>
                            <Button Content="Rescan" Click="Rescan_Click" Margin="8,0,0,0" Padding="10,5"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="On the iPhone: More ▸ Backup &amp; Transfer ▸ Flash Sync with PC ▸ Send. Hold the phone steady, fairly close, screen bright and square-on to the camera. Missed frames are normal — the transfer repairs itself and simply takes a moment longer."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <ProgressBar x:Name="RecvBar" Height="16" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RecvStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                        <TextBlock x:Name="RecvLabel" TextWrapping="Wrap" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Background="Black" CornerRadius="4" MinHeight="280">
                        <Image x:Name="CamImage" Stretch="Uniform"/>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
