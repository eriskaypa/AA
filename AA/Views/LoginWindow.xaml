<Window x:Class="AA.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AA — Sign in" Height="280" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <Border Background="{DynamicResource Bg}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="AA" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Please sign in to continue" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" Margin="0,2,0,16"/>

            <TextBlock Grid.Row="2" Text="Username" Margin="0,0,0,3"/>
            <TextBox x:Name="UserBox" Grid.Row="3" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="Password" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PassBox" Grid.Row="5" KeyDown="PassBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Grid.Row="6" Text="" Foreground="#FFD45050"
                       TextWrapping="Wrap" Margin="0,8,0,0" VerticalAlignment="Top"/>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Exit" Width="90" Margin="0,0,8,0" Click="Exit_Click"/>
                <Button Content="Sign in" Width="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Login_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
