<Window x:Class="AA.Views.ComponentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Edit component" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Name:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" TextChanged="Name_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Short notes:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="NotesBox" TextChanged="Notes_Changed"
                         ToolTip="One-line summary shown in the components list. Use the rich-text area below for the full container content."/>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <views:ContainerEditor x:Name="ContainerCtrl"/>
    </DockPanel>
</Window>
