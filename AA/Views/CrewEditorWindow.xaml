<Window x:Class="AA.Views.CrewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Edit crew member" Height="720" Width="640" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Text="Edit crew member" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <TabItem Header="Details">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Change any field and click Save. Dates use a calendar picker. Cancel discards changes to these details."
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FormHost" Margin="0,0,10,0"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Checklist">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"
                               Text="This crew member's personal checklist. Give an item a due date (in its full editor) and it shows in the 📌 due-dates window and the Calendar. Checklist changes save immediately — they are not undone by Cancel."/>
                    <views:ChecklistBuilderControl x:Name="Builder"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
