<Window x:Class="AA.Views.ContainerViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View item" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderB}"
                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
                           Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="SubText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"
                           Text="Read-only view — click a link to open it. Editing is disabled."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open all files" Margin="0,0,8,0" Click="OpenAll_Click"
                        ToolTip="Open every file listed below."/>
                <Button Content="Close" MinWidth="90" IsDefault="True" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
                <RichTextBox x:Name="Rtb" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                             Background="{DynamicResource EditorBg}" Foreground="{DynamicResource EditorFg}"
                             FontFamily="{DynamicResource MainFont}" FontSize="14"
                             VerticalScrollBarVisibility="Auto" Padding="8"/>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>

            <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="6,4"
                            BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="FilesHeader" Text="Files" FontWeight="Bold"/>
                    </Border>
                    <ListView x:Name="FilesList" BorderThickness="0" MouseDoubleClick="Files_DoubleClick"
                              ToolTip="Double-click a file to open it.">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Kind" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Source" Width="70" DisplayMemberBinding="{Binding SourceLabel}"/>
                                <GridViewColumn Header="Path / URL" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
