<Window x:Class="AA.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes before importing" Height="580" Width="760"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="SourceText" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1"
                    CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                <TextBlock x:Name="AgeText" TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="SummaryText" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Review what this import will do, then choose Import to overwrite your current data or Cancel to keep it."
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="ImportBtn" Content="Import (overwrite)" MinWidth="150"
                        Style="{StaticResource AccentButton}" IsDefault="True" Click="Import_Click"/>
            </StackPanel>
        </Border>

        <TreeView x:Name="Tree" BorderThickness="1" BorderBrush="{DynamicResource BorderB}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <DockPanel>
                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontWeight="Bold"
                                   Width="20" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="640"/>
                    </DockPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
