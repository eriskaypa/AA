<Window x:Class="AA.Views.DatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set deadline" Height="200" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Text="Set deadline" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock x:Name="LblPrompt" Grid.Row="1" Text="Deadline:" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <DatePicker x:Name="Picker" Grid.Row="2" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Clear deadline" Width="110" Margin="0,0,8,0" Click="Clear_Click"
                    ToolTip="Remove the deadline from every selected item."/>
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
