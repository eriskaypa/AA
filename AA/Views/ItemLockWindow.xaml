<Window x:Class="AA.Views.ItemLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lock entry" Height="330" Width="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/AA.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Text="Lock entry" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
        <TextBlock x:Name="LblPrompt" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                   Text="Set a password for this entry. The master password always unlocks it."/>

        <TextBlock Grid.Row="2" Text="Password:" Margin="0,0,0,3"/>
        <PasswordBox x:Name="Pb1" Grid.Row="3" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="4" Text="Confirm password:" Margin="0,0,0,3"/>
        <PasswordBox x:Name="Pb2" Grid.Row="5" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="6" Text="Hint (optional — shown on the lock screen, never the password):" Margin="0,0,0,3" TextWrapping="Wrap"/>
        <TextBox x:Name="HintBox" Grid.Row="7" VerticalAlignment="Top" Margin="0,0,0,6"/>

        <StackPanel Grid.Row="8">
            <TextBlock x:Name="LblError" Text="" Foreground="#FFD45050" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="OK" Width="90" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
