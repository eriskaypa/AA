<UserControl x:Class="AA.Views.RelationshipMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Inspect" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}"/>
                </Border>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="6" TextChanged="SearchBox_TextChanged"/>
                <ListBox x:Name="Lb" SelectionChanged="Lb_SelectionChanged" DisplayMemberPath="Display" BorderThickness="0"/>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>
        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="MapTitle" Text="Relationship Map" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}"/>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg}">
                    <Canvas x:Name="MapCanvas" Width="1400" Height="900" Background="{DynamicResource Bg}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
