<UserControl x:Class="AA.Views.CrewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: crew roster -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8,6" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="Crew" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="Import COMPAS..." Style="{StaticResource AccentButton}" Click="Import_Click" Margin="0,0,4,0"
                                    ToolTip="Import a COMPAS crew report (.xlsx) and keep each member as an info card."/>
                            <Button Content="Delete" Click="Delete_Click" ToolTip="Remove the selected crew member."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="6,4" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <Button Content="Contract expiries" Margin="0,0,4,0" Click="CheckExpiries_Click"
                                ToolTip="List crew whose contracts (sign-off dates) are due soon or overdue."/>
                        <ToggleButton x:Name="ExpiringOnlyBtn" Content="Expiring only" Margin="0,0,4,0" Click="ExpiringOnly_Click"
                                      ToolTip="Show only crew whose contract is overdue or within 60 days."/>
                        <Button Content="Clear all" Click="ClearAll_Click" ToolTip="Remove every crew member from the roster."/>
                    </WrapPanel>
                </Border>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="6" TextChanged="SearchBox_TextChanged" Tag="Search name / rank / nationality / ID..."/>
                <TextBlock x:Name="RosterStatus" DockPanel.Dock="Bottom" Margin="8,4" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <ListBox x:Name="Roster" SelectionChanged="Roster_SelectionChanged"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="2,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ExpiryText}" Foreground="{Binding ExpiryBrush}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>

        <!-- Right: crew info card -->
        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <ContentControl x:Name="CardHost"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
