<Window x:Class="AA.Views.InsertSavedListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert saved list" Height="560" Width="760" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Insert a saved list" FontWeight="Bold" FontSize="15"
                   Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="The list is added where your cursor is. Nothing already in the note is changed, and one Ctrl+Z removes the whole list again."/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="FootNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,5" Margin="0,0,8,0"/>
                <Button x:Name="OkBtn" Content="Insert" IsDefault="True" Padding="16,5" FontWeight="Bold"
                        Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                         TextChanged="Search_Changed" Tag="Search saved lists..."/>
                <ListBox x:Name="ListsBox" SelectionChanged="Lists_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,6,0,2"
                                               Foreground="{DynamicResource Muted}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BulletsRadio" Content="• Bullets" IsChecked="True"
                                     GroupName="Style" Checked="Option_Changed" Margin="0,0,14,0"/>
                        <RadioButton x:Name="NumbersRadio" Content="1. Numbered"
                                     GroupName="Style" Checked="Option_Changed"/>
                    </StackPanel>
                    <CheckBox x:Name="DurationCheck" Content="Include each item's duration" Margin="0,8,0,0"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="Appends e.g. (60 min) to each line."/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource Muted}"/>
                <Border BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
