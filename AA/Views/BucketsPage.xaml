<UserControl x:Class="AA.Views.BucketsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: bucket definitions -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8,6"
                        BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <TextBlock Text="🪣 Buckets" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}"/>
                </Border>
                <TextBlock DockPanel.Dock="Top" Margin="8,6,8,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Text="Predefine buckets here — a location, a rank, a department, anything. Then sort tasks &amp; procedures into up to two of them (in the Ctrl+N quick-work window)."/>
                <Border DockPanel.Dock="Top" Padding="6,6" BorderBrush="{DynamicResource BorderB}" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <Button Content="+ New bucket" Style="{StaticResource AccentButton}" Margin="0,0,4,4" Click="New_Click"/>
                        <Button Content="Rename" Margin="0,0,4,4" Click="Rename_Click"/>
                        <Button Content="Set category..." Margin="0,0,4,4" Click="SetCategory_Click"
                                ToolTip="Label what this bucket represents (Location, Rank, ...). Buckets are grouped by category."/>
                        <Button Content="Delete" Margin="0,0,4,4" Click="Delete_Click"/>
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <ListBox x:Name="BucketList" BorderThickness="0" SelectionChanged="BucketList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat='{}{0} items'}"
                                           Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelAlt}" Padding="6,3" Margin="0,4,0,2">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{DynamicResource Muted}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>

        <!-- Right: members of the selected bucket -->
        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderB}" BorderThickness="1" CornerRadius="4">
            <DockPanel Margin="10">
                <TextBlock x:Name="MembersHeader" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                           Text="Select a bucket to see the tasks &amp; procedures in it."/>
                <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" Margin="0,2,0,8" TextWrapping="Wrap"
                           Text="Double-click an item to open it. Right-click to remove it from this bucket."/>
                <ListBox x:Name="MemberList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="Member_DoubleClick" PreviewMouseRightButtonDown="Member_RightButtonSelect"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="OpenMember_Click"/>
                            <MenuItem Header="Remove from this bucket" Click="RemoveMember_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
