<Window x:Class="AA.Views.SubtaskBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtask builder" Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Type one subtask per line on the left and click 'Add all'. Use the right panel to reorder, edit (deadline / recurrence / status / notes) and delete subtasks. Close to save."/>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderB}"
                BorderThickness="0,0,0,1" Padding="6,5" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Saved lists:" VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                <Button Content="💾 Save as list..." Click="SaveTemplate_Click" Margin="0,0,6,0"
                        ToolTip="Save the current subtasks to the database as a reusable saved list."/>
                <Button Content="📋 Load a saved list..." Click="LoadTemplate_Click"
                        ToolTip="Insert a saved list as subtasks (append or replace)."/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: bulk entry -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Bulk entry (one subtask per line)" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Add all" Style="{StaticResource AccentButton}" Click="AddAll_Click"/>
                    <Button Content="Clear" Margin="6,0,0,0" Click="ClearText_Click"/>
                    <CheckBox x:Name="ReplaceBox" Margin="14,0,0,0" VerticalAlignment="Center"
                              ToolTip="Replace all existing subtasks instead of appending." Content="Replace existing"/>
                </StackPanel>
                <TextBox x:Name="BulkBox" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{DynamicResource BorderB}"/>

            <!-- Right: existing subtasks -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Current subtasks" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="+ Subtask" Click="AddOne_Click"
                            ToolTip="Append a new subtask to the end of the list."/>
                    <Button Content="Insert before" Margin="6,0,0,0" Click="InsertBefore_Click"
                            ToolTip="Insert a new subtask immediately above the (first) selected subtask."/>
                    <Button Content="Insert after" Margin="2,0,0,0" Click="InsertAfter_Click"
                            ToolTip="Insert a new subtask immediately below the (last) selected subtask."/>
                    <Button Content="Edit..." Margin="6,0,0,0" Click="EditOne_Click"
                            ToolTip="Open the full subtask editor (deadline / recurrence / status / notes / files)."/>
                    <Button Content="↑" MinWidth="32" Margin="6,0,0,0" Click="Up_Click"
                            ToolTip="Move selected subtask(s) up by one position."/>
                    <Button Content="↓" MinWidth="32" Margin="2,0,0,0" Click="Down_Click"
                            ToolTip="Move selected subtask(s) down by one position."/>
                    <Button Content="Move to..." Margin="6,0,0,0" Click="MoveTo_Click"
                            ToolTip="Move selected subtask(s) to a specific position (top / bottom / before another subtask)."/>
                    <Button Content="Delete" Margin="6,0,0,0" Click="Delete_Click"/>
                </StackPanel>
                <ListBox x:Name="ItemsList" SelectionMode="Extended" MouseDoubleClick="ItemsList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Text="{Binding Deadline, StringFormat='yyyy-MM-dd'}"/>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                           TextDecorations="{Binding IsComplete, Converter={StaticResource BoolToStrike}}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
