<Window x:Class="AA.Views.ChecklistStepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AA.Views"
        Title="Edit checklist step" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/AA.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Title:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="TitleBox" TextChanged="Title_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Deadline:" Width="100" VerticalAlignment="Center"/>
                <DatePicker x:Name="DeadlinePicker" Width="200" HorizontalAlignment="Left" SelectedDateChanged="Deadline_Changed"
                            ToolTip="Optional per-step due date — the step then behaves like a task subtask (shows in the Calendar and the floating due-dates window)."/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Status:" Width="100" VerticalAlignment="Center"/>
                <CheckBox x:Name="DoneBox" Content="Done" Checked="Done_Changed" Unchecked="Done_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="Job:" Width="100" VerticalAlignment="Center"/>
                <CheckBox x:Name="JobBox" Content="Schedulable job" VerticalAlignment="Center"
                          Checked="Job_Changed" Unchecked="Job_Changed"
                          ToolTip="Tag this step as a Job so it can be dragged onto the Planner."/>
                <TextBlock Text="Duration (min):" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="DurationBox" Width="80" HorizontalAlignment="Left" TextChanged="Duration_Changed"/>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <views:ContainerEditor x:Name="ContainerCtrl"/>
    </DockPanel>
</Window>
